<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_gradient_main">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/vaultTitleTv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
        <Button android:id="@+id/recycleBinBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bin" android:backgroundTint="@color/accent_purple" android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView android:id="@+id/vaultUsedTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" />
    <Button android:id="@+id/newFolderBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="+ New Folder" android:background="@drawable/bg_button_gradient" android:textColor="#FFFFFF" />
    
    <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="No folders yet.\nTap '+ New Folder' to start." android:textColor="@color/text_secondary" android:textSize="18sp" android:visibility="gone" />
    
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/foldersRv" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" />
</LinearLayout>
