<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_gradient_main">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity History" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
        <TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
    </ScrollView>
</LinearLayout>
