<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/editNameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editSizeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8A93A3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tags (comma separated)"
            android:textColor="#8A93A3" />

        <EditText
            android:id="@+id/editTagsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. work, 2024, draft"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A93A3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Description"
            android:textColor="#8A93A3" />

        <EditText
            android:id="@+id/editDescInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="What is this file?"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A93A3"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Version tag"
            android:textColor="#8A93A3" />

        <EditText
            android:id="@+id/editVersionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. v1, v2, draft-final"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A93A3" />

        <CheckBox
            android:id="@+id/editImportantCb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mark as important"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/editSaveBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>