<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_gradient_main">
    
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recycle Bin" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/binSizeTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" />
    <Button android:id="@+id/emptyBinBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Empty Bin" android:backgroundTint="@color/accent_pink" android:textColor="#FFFFFF" />
    
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/trashRv" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" />
</LinearLayout>
